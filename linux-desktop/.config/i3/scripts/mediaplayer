#!/bin/sh

# i3blocks adapter for the selected MPRIS player; Spotify is the default.
if ! command -v playerctl >/dev/null 2>&1; then
  printf '[missing playerctl]\n'
  printf 'mediaplayer: install playerctl for the media block\n' >&2
  exit 1
fi
player=${BLOCK_INSTANCE:-spotify}
set --
delay=0
case ${BLOCK_BUTTON:-} in
  1) set -- previous; delay=1 ;;
  2) set -- play-pause ;;
  3) set -- next; delay=1 ;;
  4) set -- volume 0.01+ ;;
  5) set -- volume 0.01- ;;
esac
if [ "$#" -gt 0 ]; then
  # A rejected action must not hide otherwise valid now-playing metadata.
  playerctl --player="$player" "$@" >/dev/null 2>&1 || :
  if [ "$player" = spotify ] && [ "$delay" = 1 ]; then
    sleep 0.05
  fi
fi
# One metadata query; a field separator keeps artist/title independent.
separator=$(printf '\037')
metadata=$(playerctl --player="$player" metadata \
  --format "{{ artist }}${separator}{{ title }}" 2>/dev/null) || exit 0
artist=${metadata%%"$separator"*}
title=${metadata#*"$separator"}
if [ -n "$artist" ] && [ -n "$title" ]; then
  printf '%s - %s\n' "$artist" "$title"
elif [ -n "$artist$title" ]; then
  printf '%s%s\n' "$artist" "$title"
fi
