# Global properties
command=~/.config/i3blocks/blocklet
separator_block_width=15
markup=none

# Generic media player support
# This displays "ARTIST - SONG" if a music is playing.
[mediaplayer]
command=~/.config/i3/scripts/mediaplayer
label=♪
instance=spotify
interval=5
signal=10

# Memory usage
[memory]
label=MEM
separator=false
interval=30

[memory]
label=SWAP
instance=swap
separator=false
interval=30

# Disk usage
[disk]
label=HOME
#instance=/mnt/data
interval=30

# Network interface monitoring
[iface]
color=#00FF00
interval=10
separator=false

[bandwidth]
#instance=eth0
interval=5

# CPU usage
[cpu_usage]
label=CPU
interval=10
min_width=CPU: 100.00%
#separator=false

#[load_average]
#interval=10

# Date Time
[time]
command=date '+%Y-%m-%d %H:%M:%S'
interval=5

# Key indicators
#
# i3 sends signal 11 on Caps/Num Lock release; update once at startup too.
[keyindicator]
markup=pango
instance=CAPS
interval=once
signal=11

#[keyindicator]
#instance=NUM
#interval=once
#signal=11
