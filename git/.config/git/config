[user]
	useConfigOnly = true
[pull]
	rebase = true
[core]
	pager = command -v delta >/dev/null 2>&1 && exec delta || exec less -FRX
[interactive]
	diffFilter = command -v delta >/dev/null 2>&1 && exec delta --color-only || exec cat
[color]
	ui = true
[color "diff"]
	meta = yellow
	frag = magenta bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[merge]
	tool = vimdiff
[diff]
	tool = vimdiff
[delta]
	navigate = true
[difftool]
	prompt = false
[alias]
	d = difftool
