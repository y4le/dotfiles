# Zsh helper: EDITOR is an executable plus quoted arguments, not shell code.
function nav() {
  if [[ -z ${ZSH_VERSION:-} ]]; then
    printf '%s\n' 'nav: this helper requires Zsh' >&2
    return 1
  fi
  emulate -L zsh
  if ! command -v fzf >/dev/null 2>&1; then
    printf '%s\n' 'nav: fzf is not available' >&2
    return 127
  fi
  local sel picker_rc editor_command="${EDITOR:-vim}"
  local -a editor_argv
  [[ -n ${editor_command//[[:space:]]/} ]] || editor_command=vim
  editor_argv=("${(@Q)${(z)editor_command}}")
  while true; do
    if sel=$(
      { printf '..\0'; find . ! -path . -prune -print0; } |
        fzf --read0 --print0 --reverse --preview '
        __nav_path={}
        if [ -d "$__nav_path" ]; then
          printf "%s\n\n" "$__nav_path"
          ls -ap "$__nav_path"
        else
          printf "%s\n" "$__nav_path"
          if command -v bat >/dev/null 2>&1; then
            bat --color=always --line-range :200 "$__nav_path"
          else
            head -200 "$__nav_path"
          fi
        fi
        '
    ); then
      picker_rc=0
    else
      picker_rc=$?
    fi
    case $picker_rc in
      0) ;;
      1 | 130) return 0 ;;
      *) printf 'nav: fzf failed (status %s)\n' "$picker_rc" >&2; return "$picker_rc" ;;
    esac
    [[ -n $sel ]] || return 0
    sel=${sel%$'\0'}
    if [ -d "$sel" ]; then
      builtin cd -- "$sel" >/dev/null || return "$?"
    else
      "${editor_argv[@]}" "$sel" || return "$?"
    fi
  done
}
