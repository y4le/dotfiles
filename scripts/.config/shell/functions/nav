function nav() {
  local sel
  while true; do
    if ! IFS= read -r -d '' sel < <(
      { printf '..\0'; find . ! -path . -prune -print0; } |
        fzf --read0 --print0 --reverse --preview '
        __nav_path={}
        if [ -d "$__nav_path" ]; then
          printf "%s\n\n" "$__nav_path"
          ls -ap "$__nav_path"
        else
          printf "%s\n" "$__nav_path"
          if command -v bat >/dev/null 2>&1; then
            bat --color=always --line-range :200 "$__nav_path"
          else
            head -200 "$__nav_path"
          fi
        fi
        '
    ); then
      return 0
    fi
    if [ -d "$sel" ]; then
      builtin cd "$sel" &> /dev/null
    else
      ${EDITOR:-vim} "$sel"
    fi
  done
}
