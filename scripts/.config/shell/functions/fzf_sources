#!/bin/bash

# filez sets root_file, hidden, and debug before calling fzf_src. Sources emit
# NUL-delimited paths; filez chooses the delimiter needed by its caller.
# shellcheck disable=SC2154

git_source() {
  command -v git >/dev/null 2>&1 || return 1
  git -C "$root_file" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1

  local path
  while IFS= read -r -d '' path; do
    [[ -f $root_file/$path ]] && printf '%s/%s\0' "$root_file" "$path"
  done < <(git -C "$root_file" ls-files --cached --others --exclude-standard -z)
  return 0
}

rg_source() {
  command -v rg >/dev/null 2>&1 || return 1
  local -a args=(--files -0)
  [[ $hidden = true ]] && args+=(--hidden)
  rg "${args[@]}" "$root_file"
}

fd_source() {
  command -v fd >/dev/null 2>&1 || return 1
  local -a args=(--type f -0)
  [[ $hidden = true ]] && args+=(--hidden)
  fd "${args[@]}" . "$root_file" 2>/dev/null
}

find_source() {
  command -v find >/dev/null 2>&1 || return 1
  if [[ $hidden = true ]]; then
    find "$root_file" -type f -print0
  else
    find "$root_file" -mindepth 1 -name '.*' -prune -o -type f -print0
  fi
}

fzf_src() {
  local source
  for source in git_source rg_source fd_source find_source; do
    if "$source"; then
      [[ $debug = true ]] && printf 'filez source: %s (root: %s)\n' "$source" "$root_file" >&2
      return 0
    fi
  done
  [[ $debug = true ]] && printf 'filez: no source for %s\n' "$root_file" >&2
  return 1
}
