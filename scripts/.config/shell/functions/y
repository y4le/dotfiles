# Yazi must run in the caller's shell so its selected directory becomes PWD.
function y() {
  emulate -L zsh
  if ! command -v yazi >/dev/null 2>&1; then
    print -u2 "yazi not found - add yazi to your saved WITH list, keeping existing packs, then run 'make setup-user' from your dotfiles repo (see docs/setup.md)"
    return 127
  fi

  local tmp cwd yazi_rc=0
  tmp=$(mktemp -t 'yazi-cwd.XXXXXX') || return
  {
    command yazi --cwd-file="$tmp" "$@"
    yazi_rc=$?
    if (( yazi_rc == 0 )); then
      # Upstream writes a path without a NUL terminator; EOF still fills cwd.
      IFS= read -r -d '' cwd < "$tmp" || :
      if [[ -n $cwd && $cwd != $PWD ]]; then
        builtin cd -- "$cwd" || yazi_rc=$?
      fi
    fi
  } always {
    command rm -f -- "$tmp"
  }
  return "$yazi_rc"
}
