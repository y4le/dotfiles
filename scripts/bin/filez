#!/bin/bash

# grab the actual fzf_src function
# This resolves to the stowed file in ~/.config/shell/functions at runtime.
# shellcheck source=/dev/null
. "$HOME/.config/shell/functions/fzf_sources"


# Set the parameters consumed by fzf_src.
# fzf_sources reads this from the caller's shell after being sourced.
# shellcheck disable=SC2034
root_file=.
# fzf_sources reads this from the caller's shell after being sourced.
# shellcheck disable=SC2034
hidden=false
# fzf_sources reads this from the caller's shell after being sourced.
# shellcheck disable=SC2034
debug=false
print0=false

while [ "$1" != "" ]; do
  case $1 in
    -r | --root )
      shift
      # This reassignment is consumed by the sourced helper, not locally here.
      # shellcheck disable=SC2034
      root_file=$1
      ;;
    -h | --hidden )
      # This reassignment is consumed by the sourced helper, not locally here.
      # shellcheck disable=SC2034
      hidden=true
      ;;
    -d | --debug )
      # This reassignment is consumed by the sourced helper, not locally here.
      # shellcheck disable=SC2034
      debug=true
      ;;
    -0 | --print0 )
      print0=true
      ;;
  esac
  shift
done

if [ "$root_file" != . ]; then
  root_file=$(CDPATH='' cd -- "$root_file" && pwd -P) || exit 1
fi

if [ "$print0" = true ]; then
  fzf_src
else
  fzf_src | tr '\000' '\n'
fi
