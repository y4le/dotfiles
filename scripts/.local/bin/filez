#!/bin/bash

# File-picker candidates, with Git membership preferred over filesystem scans.
# Every source emits NUL-delimited paths. Keep producer failures through pipes.
set -o pipefail

usage() {
  cat <<'HELP'
Usage: filez [-r DIR] [-h] [-0] [-d]

List existing tracked and nonignored untracked files below the root in Git
worktrees, or use ripgrep's filesystem scan elsewhere. Git metadata roots
are rejected. Directories and submodule contents are not listed.

  -r, --root DIR  Search DIR (default: .); nondefault roots emit absolute paths
  -h, --hidden    Include hidden paths in filesystem scans; Git includes dotfiles
  -0, --print0    Separate paths with NUL (default: newline)
  -d, --debug     Report the selected source and root on stderr
      --help      Show this help

Requires Git 2.31+ in worktrees, or ripgrep elsewhere. Newline output cannot
represent filenames containing newlines; use --print0 for machine consumers.
HELP
}

usage_error() {
  printf 'filez: %s\nTry filez --help.\n' "$*" >&2
  exit 2
}

git_files() {
  local root=$1 path
  git -C "$root" ls-files --cached --others --exclude-standard --deduplicate -z |
    while IFS= read -r -d '' path; do
      if [[ -f $root/$path ]]; then
        printf '%s/%s\0' "$root" "$path" || return
      fi
    done
}

filesystem_files() {
  local root=$1 hidden=$2 source_rc
  local -a args=(--no-config --files -0 -g '!.git')
  [[ $hidden = true ]] && args+=(--hidden)
  rg "${args[@]}" -- "$root"
  source_rc=$?
  # An empty listing is success. Preserve partial I/O errors and diagnostics.
  [[ $source_rc = 1 ]] && return 0
  return "$source_rc"
}

root=.
hidden=false
print0=false
debug=false
while (( $# )); do
  case $1 in
    -r | --root)
      (( $# >= 2 )) && [[ -n $2 ]] || usage_error "$1 requires a directory"
      root=$2
      shift 2
      ;;
    -h | --hidden) hidden=true; shift ;;
    -0 | --print0) print0=true; shift ;;
    -d | --debug) debug=true; shift ;;
    --help) usage; exit 0 ;;
    --)
      shift
      (( $# == 0 )) || usage_error "unexpected argument: $1"
      break
      ;;
    *) usage_error "unknown argument: $1" ;;
  esac
done

[[ -d $root ]] || { printf 'filez: not a directory: %s\n' "$root" >&2; exit 1; }
if [[ $root != . ]]; then
  # Resolve inside this process to preserve newlines; ./ makes '-' literal.
  [[ $root = /* ]] || root=./$root
  CDPATH='' cd -P -- "$root" || exit 1
  root=$PWD
fi

source=filesystem_files
if command -v git >/dev/null 2>&1; then
  if [[ $(git -C "$root" rev-parse --is-inside-work-tree 2>/dev/null) = true ]]; then
    source=git_files
  elif [[ $(git -C "$root" rev-parse --is-inside-git-dir 2>/dev/null) = true ]]; then
    printf 'filez: root is Git metadata; choose a working directory: %s\n' "$root" >&2
    exit 1
  fi
fi
if [[ $source = filesystem_files ]] && ! command -v rg >/dev/null 2>&1; then
  printf 'filez: ripgrep is required outside Git worktrees; run make tools\n' >&2
  exit 127
fi
[[ $debug = true ]] && printf 'filez source: %s (root: %s)\n' "$source" "$root" >&2

if [[ $print0 = true ]]; then
  "$source" "$root" "$hidden"
else
  "$source" "$root" "$hidden" | tr '\000' '\n'
fi
